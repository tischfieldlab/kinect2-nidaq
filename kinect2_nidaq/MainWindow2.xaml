<Window x:Class="kinect2_nidaq.MainWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kinect2_nidaq"
        xmlns:properties="clr-namespace:kinect2_nidaq.Properties"
        xmlns:views="clr-namespace:kinect2_nidaq.Views"
        mc:Ignorable="d"
        Title="Kinect2 Nidaq"
        Height="640.909"
        Width="1046.213"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        Background="AliceBlue" 
        BorderBrush="Black" 
        BorderThickness="1">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Name="ExitButton" Click="ExitButton_Click" FontSize="18">
                Exit
            </Button>
        </Grid>
        <TabControl Grid.Row="1" Background="AliceBlue">
            <TabItem Header="Session Settings">
                <views:SessionSettings />
            </TabItem>
            <TabItem Header="Kinect Preview">
                <views:VideoPreview />
            </TabItem>
        </TabControl>
        <views:StatusBar Grid.Row="2" />
    </Grid>
</Window>
