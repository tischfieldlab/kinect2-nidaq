<UserControl x:Class="kinect2_nidaq.Views.SessionSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:kinect2_nidaq.Views"
             xmlns:properties="clr-namespace:kinect2_nidaq.Properties"
             xmlns:conv="clr-namespace:kinect2_nidaq.Views.Converters"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White">
    <UserControl.Resources>
        <conv:BooleanInvertConverter x:Key="BooleanInvertConverter" />
    </UserControl.Resources>
    <Grid IsEnabled="{Binding Path=Settings.IsSettingsEnabled}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="{Binding Source={x:Static properties:Settings.Default}, Path=NidaqWidth}" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="5" Background="Gray"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="5" />
                <RowDefinition Height="150" />
            </Grid.RowDefinitions>

            <local:NIAnalogDAQ Grid.Row="0" />

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="5" Background="Gray"/>

            <local:NIDigitalDAQ Grid.Row="2" />

        </Grid>




        <Grid Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition />
                <RowDefinition Height="40" />
                <RowDefinition />
                <RowDefinition Height="40" />
                <RowDefinition />
                <RowDefinition Height="40" />
                <RowDefinition />
                <RowDefinition Height="60" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="21*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Kinect" FontSize="15" HorizontalAlignment="Center" Grid.ColumnSpan="3" VerticalAlignment="Bottom" FontWeight="Black"/>

            <TextBlock Text="Session Name" Grid.Column="1" Grid.Row="1" TextAlignment="Center" VerticalAlignment="Bottom" Grid.ColumnSpan="2"/>
            <TextBox Name="SessionName"
                     Grid.Column="1"
                     Grid.Row="2"
                     Text="{Binding Path=Settings.SessionName}"
                     Grid.ColumnSpan="2" />


            <TextBlock Text="Subject Name" Grid.Column="1" Grid.Row="3" TextAlignment="Center" VerticalAlignment="Bottom" Grid.ColumnSpan="2" />
            <TextBox Name="SubjectName"
                     Grid.Column="1"
                     Grid.Row="4"
                     Text="{Binding Path=Settings.SubjectName}"
                     Grid.ColumnSpan="2" />


            <TextBlock Text="Save Directory" Grid.Column="1" Grid.Row="5" TextAlignment="Center" VerticalAlignment="Bottom" Grid.ColumnSpan="2" />
            <Button Content="..." HorizontalAlignment="Left"  x:Name="SelectDirectory" Click="SelectDirectory_Click" Grid.Column="0" Grid.Row="6"/>
            <TextBox Name="FolderName"
                     Grid.Column="1"
                     Grid.Row="6"
                     Text="{Binding Path=Settings.FolderName}"
                     Grid.ColumnSpan="2" />


            <Grid Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <CheckBox Name="CheckNoTimer"
                          VerticalAlignment="Center"
                          IsChecked="{Binding Path=Settings.IsIndeterminateRecording}"
                          IsEnabled="{Binding Path=Settings.IsIndeterminateRecordingEnabled}">
                    <TextBlock Text="Record until user clicks stop" VerticalAlignment="Center" />
                </CheckBox>
                <CheckBox VerticalAlignment="Center"
                          Grid.Row="1"
                          Grid.Column="0"
                          Name="PreviewMode"
                          IsChecked="{Binding Path=Settings.IsPreviewMode}">
                    <TextBlock Text="Preview Mode" />
                </CheckBox>
                <CheckBox VerticalAlignment="Center"
                          Grid.Row="2"
                          Grid.Column="0"
                          Name="CompressionMode"
                          IsChecked="{Binding Path=Settings.CompressSession}"
                          IsEnabled="{Binding Path=Settings.IsCompressSessionEnabled}">
                    <TextBlock Text="Compress Session" />
                </CheckBox>
                <Grid Grid.Column="1" Grid.RowSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Name="RecordingTimeBox"
                             Text="{Binding Path=Settings.RecordingDuration}"
                             IsEnabled="{Binding Path=Settings.IsRecordingDurationEnabled}"
                             />
                    <TextBlock Text="Recording time (minutes)"
                               Name="RecordingTimeText" 
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"  />
                </Grid>
            </Grid>
            <Grid Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <CheckBox VerticalAlignment="Center"
                          Name="CheckDepthStream"
                          IsChecked="{Binding Path=Settings.IsDepthStreamEnabled}">
                        <TextBlock Text="Depth Stream" />
                    </CheckBox>
                    <CheckBox VerticalAlignment="Center"
                          Name="CheckIRStream"
                          IsChecked="{Binding Path=Settings.IsIRStreamEnabled}">
                        <TextBlock Text="IR Stream" />
                    </CheckBox>
                    <CheckBox VerticalAlignment="Center"
                          Name="CheckColorStream"
                          IsChecked="{Binding Path=Settings.IsColorStreamEnabled}">
                        <TextBlock Text="Color Stream" />
                    </CheckBox>

                    <CheckBox VerticalAlignment="Center"
                          Name="CheckNidaqStream"
                          IsChecked="{Binding Path=Settings.AnalogNIDAQ.IsEnabled}">
                        <TextBlock Text="Nidaq Stream" />
                    </CheckBox>

                </StackPanel>
                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Start Session"
                            Command="{Binding Path=StartRecordingCommand}"
                            Name="StartButton"
                            Grid.Column="0"
                            Height="35"
                            Background="LightGreen"/>

                    <local:ResetIsEnabled Grid.Column="2">
                        <Button Content="Stop Session"
                            Name="StopButton"
                            Command="{Binding Path=StopRecordingCommand}"
                            Height="35"
                            Background="LightSalmon" />
                    </local:ResetIsEnabled>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
